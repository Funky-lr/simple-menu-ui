; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Simple_Menu_UI"
config/tags=PackedStringArray("system_template")
run/main_scene="uid://iere7p880kjv"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout=""

[autoload]

BusManager="*uid://dg0db7gklr7e0"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://addons/": "yellow",
"res://addons/main_menu_template/Scenes/": "orange",
"res://addons/main_menu_template/Scripts/": "red"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
